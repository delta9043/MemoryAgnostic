# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  copy .env.example .env
# .env 는 git에 올리지 마세요 (API key 노출).

# 필수: OpenAI API key
OPENAI_API_KEY=sk-...

# 모델 설정 (CLI 인자로 덮어쓸 수 있음)
GOLD_MODEL=gpt-5.6-sol

# temperature: 비우면 API 기본값 사용 (reasoning 모델은 미지원일 수 있음).
# 재현성을 원하고 모델이 지원하면 0 으로.
GOLD_TEMPERATURE=

# 동시 API 요청 수
GOLD_CONCURRENCY=8
